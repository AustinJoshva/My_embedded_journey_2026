int redPin = 3;

void setup() {
pinMode(redPin,OUTPUT);

}

void loop() {
  
digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(1500);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(1500);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(1500);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(500);

digitalWrite(redPin,HIGH);
delay(750);
digitalWrite(redPin,LOW);
delay(5000);

}
